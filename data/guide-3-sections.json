  {
    "id": "poudres",
    "statut": "actif",
    "titre": "Les protéines à saupoudrer",
    "resume": null,
    "corps": [
      {
        "type": "texte",
        "balise": "p",
        "classe": "p",
        "texte": "Pour ajouter des protéines à un plat <strong>sans en changer les proportions</strong>, la cuisine japonaise a déjà ses solutions — et ce sont des aliments, pas des suppléments. Ils se trouvent tous ici, au rayon des produits séchés."
      },
