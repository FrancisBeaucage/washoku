                "type": "texte",
                "balise": "p",
                "attrs": " style=\"margin:0;font-size:14px;line-height:1.6;color:#605d5d\"",
                "texte": "Il est au réfrigéré, à côté du tofu. Toujours.",
                "blanc": ""
              }
            ],
            "queue": ""
          },
          {
            "attrs": " style=\"background:#f3f2f2;padding:20px\"",
            "blocs": [
              {
                "type": "texte",
                "balise": "p",
                "attrs": " style=\"margin:0 0 6px;font-weight:800;font-size:24px;color:#ec3013;line-height:1\"",
                "texte": "2",
                "blanc": ""
              },
              {
                "type": "texte",
                "balise": "p",
                "attrs": " style=\"margin:0 0 5px;font-size:16px;font-weight:800;line-height:1.2\"",
                "texte": "Chercher le dashi près du thé.",
                "blanc": ""
              },
              {
                "type": "texte",
                "balise": "p",
                "attrs": " style=\"margin:0;font-size:14px;line-height:1.6;color:#605d5d\"",
                "texte": "Les sachets de dashi sont dans l'allée japonaise&nbsp;; le kombu et le katsuobushi sont dans l'allée des séchés.",
                "blanc": ""
              }
            ],
            "queue": ""
          },
          {
            "attrs": " style=\"background:#f3f2f2;padding:20px\"",
            "blocs": [
              {
                "type": "texte",
                "balise": "p",
                "attrs": " style=\"margin:0 0 6px;font-weight:800;font-size:24px;color:#ec3013;line-height:1\"",
                "texte": "3",
