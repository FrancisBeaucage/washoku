                "balise": "p",
                "attrs": " style=\"margin:0;font-size:14px;line-height:1.6;color:#605d5d\"",
                "texte": "Le nori en collation est salé et huilé. Le <strong>yaki nori nature</strong> est en grandes feuilles, dans un paquet plat rigide.",
                "blanc": ""
              }
            ],
            "queue": ""
          },
          {
            "attrs": " style=\"background:#ec3013;color:#fff;padding:20px\"",
            "blocs": [
              {
                "type": "texte",
                "balise": "p",
                "attrs": " style=\"margin:0 0 6px;font-weight:800;font-size:24px;color:#ffc4b8;line-height:1\"",
                "texte": "6",
                "blanc": ""
              },
              {
                "type": "texte",
                "balise": "p",
                "attrs": " style=\"margin:0 0 5px;font-size:16px;font-weight:800;line-height:1.2\"",
                "texte": "Vouloir tout acheter d'un coup.",
