    {
      "texte": "NUOC CHAM — 3 c. à soupe d'eau tiède, 2 c. à soupe de jus de lime, 1,5 c. à soupe de sauce de poisson, 1 c. à soupe de sucre, ail, piment",
      "sante": false,
      "sante_pos": null
    },
    {
      "texte": "Vermicelles de riz, portion modeste",
      "sante": false,
      "sante_pos": null
    }
