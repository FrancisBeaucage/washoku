  "techniques": [],
  "etapes": [
    {
      "n": 1,
      "texte": "Mariner le porc 20 minutes, former de petites galettes plates."
    },
    {
      "n": 2,
      "texte": "Gril du four ou poêle, 4 minutes par côté."
