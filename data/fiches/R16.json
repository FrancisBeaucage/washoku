  ],
  "etapes": [
    {
      "n": 1,
      "texte": "Porter le liquide à frémissement dans une poêle large avec le gingembre."
    },
    {
      "n": 2,
      "texte": "Déposer le poisson en une seule couche, peau vers le haut."
    },
    {
      "n": 3,
      "texte": "Couvrir d'un otoshibuta — un couvercle qui repose directement sur les aliments. Un cercle de papier parchemin fait l'affaire."
    },
    {
      "n": 4,
      "texte": "Mijoter 10 à 12 minutes."
    }
  ],
  "notes": [
    {
      "titre": "L'otoshibuta",
      "texte": "Ça fait circuler le liquide par-dessus le poisson sans qu'on ait à le retourner. C'est ce qui empêche les filets de se défaire."
