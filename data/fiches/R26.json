  "ingredients": [
    {
      "texte": "600 g de tofu ferme ou mi-ferme en cubes de 2 cm",
      "sante": false,
      "sante_pos": null
    },
    {
      "texte": "200 g de porc haché maigre",
      "sante": false,
      "sante_pos": null
    },
    {
      "texte": "1 c. à soupe de doubanjiang",
      "sante": false,
      "sante_pos": null
    },
    {
      "texte": "1 c. à thé de poivre de Sichuan moulu",
      "sante": false,
      "sante_pos": null
    },
    {
      "texte": "3 gousses d'ail, 1 c. à soupe de gingembre",
      "sante": false,
      "sante_pos": null
    },
    {
      "texte": "200 ml de bouillon, 1 c. à soupe de fécule délayée",
      "sante": false,
      "sante_pos": null
    },
    {
      "texte": "Oignons verts",
      "sante": false,
      "sante_pos": null
    }
  ],
  "techniques": [],
  "etapes": [
    {
      "n": 1,
      "texte": "Pocher les cubes de tofu 2 minutes dans de l'eau salée frémissante, puis égoutter. Ça les raffermit et les empêche de se défaire."
    },
    {
      "n": 2,
      "texte": "Saisir le porc, ajouter doubanjiang, ail et gingembre, 2 minutes."
    },
    {
      "n": 3,
      "texte": "Ajouter le bouillon et le tofu. Mijoter 5 minutes sans brasser — secouer la poêle par le manche."
    },
    {
      "n": 4,
      "texte": "Épaissir. Poivre de Sichuan à la toute fin, hors du feu : la chaleur détruit son parfum citronné."
    }
  ],
