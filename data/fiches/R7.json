  "ingredients": [
    {
      "texte": "3 œufs battus",
      "sante": false,
      "sante_pos": null
    },
    {
      "texte": "450 ml de dashi tiède (T2)",
      "sante": false,
      "sante_pos": null
    },
    {
      "texte": "1 c. à thé de sauce soya, 1 c. à thé de mirin",
      "sante": false,
      "sante_pos": null
    },
    {
      "texte": "Garnitures : crevettes, champignons, oignon vert",
      "sante": false,
      "sante_pos": null
    }
  ],
  "techniques": [
    "T2"
  ],
  "etapes": [
    {
      "n": 1,
      "texte": "Battre les œufs sans faire de mousse. Ajouter le dashi tiède et les assaisonnements."
    },
    {
      "n": 2,
      "texte": "Filtrer à travers une passoire fine. C'est ce qui donne la texture soyeuse."
    },
    {
      "n": 3,
      "texte": "Répartir dans des tasses, déposer les garnitures."
    },
    {
      "n": 4,
      "texte": "Cuire à la vapeur à feu doux, à couvert, 12 minutes."
    }
  ],
  "notes": [
    {
      "titre": "Feu doux, vraiment",
      "texte": "Feu trop fort = texture caillée avec des trous. C'est la seule chose qui peut rater dans cette recette."
    }
  ],
